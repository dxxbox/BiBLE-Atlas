+	dataMap, ok := resp.Data.(map[string]any)
+	if !ok {
+		t.Fatalf("expected object data")
+	}
+	if dataMap["memory_id"] != "mem_build-meta-test" {
+		t.Fatalf("expected memory_id=mem_build-meta-test, got %v", dataMap["memory_id"])
+	}
+}
