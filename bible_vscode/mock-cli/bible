#!/usr/bin/env node
/* eslint-disable */
/**
 * Mock bible CLI —— 用于开发期解耦真 CLI 进度。
 *
 * 协议：与 docs/manual/cli-contract-v1.md 一致：
 *   - 成功：exit=0，stdout 单行 JSON `{ok:true, data:...}`
 *   - 失败：exit=1（CLI_NOT_IMPLEMENTED 用 exit=3），stdout 单行 JSON `{ok:false, error:{code, message}}`
 *
 * 行为见 backlog/memory-closure-collab-plan-zh.md §5.2 / §5.3。
 *
 * 行为控制（按优先级从高到低）：
 *   1. 环境变量 BIBLE_MOCK_INJECT=<scenario>（向后兼容）
 *   2. Profile 文件：BIBLE_MOCK_PROFILE 指定的路径，默认 ~/.bible-mock.json
 *      mock-cli 每次启动都重新读，所以 profile 改完保存即生效，无需重启 IDE。
 *      schema 见下方 DEFAULT_PROFILE / openMockProfile 命令的模板。
 *
 * 任务状态用 /tmp/bible-mock-tasks.json 持久化（多次 task get 之间保持）。
 * 想重置：删 /tmp/bible-mock-tasks.json，或让 profile.task.completeAt 改变后用新 task。
 */
'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const crypto = require('node:crypto');

const rawArgv = process.argv.slice(2);
// Strip global --test flag: when present, log it and continue with remaining args.
const testModeIdx = rawArgv.indexOf('--test');
const isTestMode = testModeIdx !== -1;
const argv = isTestMode ? rawArgv.filter(a => a !== '--test') : rawArgv;
const STATE_PATH = path.join(os.tmpdir(), 'bible-mock-tasks.json');
const PROFILE_PATH = process.env.BIBLE_MOCK_PROFILE || path.join(os.homedir(), '.bible-mock.json');

const DEFAULT_PROFILE = {
  inject: null,
  search: {
    count: 3,
    abstractTemplate: 'Discussion about {query} (#{i})',
    longAbstract: false,
    longAbstractRepeat: 12,
    errorIfQueryContains: 'error',
    scoreStart: 0.92,
    scoreStep: 0.08,
    sessionIdPrefix: 'mock-session',
    hitField: 'abstract',
    sessionKind: 'mixed',
  },
  task: {
    completeAt: 3,
    failAt: null,
  },
  artifact: {
    fixtureFile: null,
    contentType: 'application/json',
  },
};

const profile = loadProfile();
const inject = process.env.BIBLE_MOCK_INJECT || profile.inject || '';

main();

function main() {
  try {
    if (isTestMode) {
      process.stderr.write(`[mock-cli] --test flag detected (test mode ON); args after strip: ${JSON.stringify(argv)}\n`);
    }
    if (inject === 'not_implemented') {
      return failExit(3, 'CLI_NOT_IMPLEMENTED', `mock CLI: injection 'not_implemented' active`);
    }
    if (argv.length === 0) return ok({ usage: 'bible <command> ...' });

    const [cmd, ...rest] = argv;
    switch (cmd) {
      case 'health':                return cmdHealth();
      case 'memory':                return dispatchMemory(rest);
      case 'task':                  return dispatchTask(rest);
      default:                      return failExit(3, 'CLI_NOT_IMPLEMENTED', `unknown command: ${cmd}`);
    }
  } catch (err) {
    return fail('INTERNAL', `mock CLI threw: ${err && err.message || String(err)}`);
  }
}

// ---------- health ----------

function cmdHealth() {
  return ok({
    cli: 'mock',
    version: '0.0.0-mock',
    server: { reachable: true, url: 'mock://localhost' },
  });
}

// ---------- memory ----------

function dispatchMemory(args) {
  const [sub, ...rest] = args;
  switch (sub) {
    case 'search':                  return cmdMemorySearch(rest);
    case 'upload':                  return cmdMemoryUpload(rest);
    case 'download':                return cmdMemoryDownload(rest);
    case '--help':                  return ok({ commands: ['search', 'upload', 'download'] });
    default:                        return failExit(3, 'CLI_NOT_IMPLEMENTED', `memory ${sub}`);
  }
}

function cmdMemorySearch(args) {
  if (args.includes('--help')) return ok({});
  const flags = parseFlags(args);
  // CLI: memory search <query> [--top-k N] — query 是 positional 第一个非 flag 参数
  const query = args.find(a => !a.startsWith('--')) || '';

  const cfg = profile.search;
  const trigger = (cfg.errorIfQueryContains || '').trim();
  if (trigger && query.toLowerCase().includes(trigger.toLowerCase())) {
    return fail('INTERNAL', `mock-injected error for query: ${query}`);
  }

  const count = Math.max(0, Number(cfg.count));
  const results = [];
  for (let i = 0; i < count; i++) {
    const sessionId = `${cfg.sessionIdPrefix || 'mock-session'}-${String(i + 1).padStart(3, '0')}`;
    const score = Math.max(0, Number(cfg.scoreStart) - i * Number(cfg.scoreStep));
    const tpl = cfg.abstractTemplate || 'Match {i} for {query}';
    let abstract = tpl
      .replace(/\{query\}/g, query || '(empty)')
      .replace(/\{i\}/g, String(i + 1))
      .replace(/\{sessionId\}/g, sessionId);
    if (cfg.longAbstract) {
      abstract = Array(Math.max(1, Number(cfg.longAbstractRepeat) || 12)).fill(abstract).join(' ');
    }
    results.push({
      session_id: sessionId,
      storage_path: `mock/memory/${sessionId}.json`,
      abstract,
      score: round2(score),
      hit_field: cfg.hitField || 'abstract',
      snippet: abstract.length > 200 ? abstract.slice(0, 200) + '…' : abstract,
      meta: { session_kind: cfg.sessionKind || 'mixed' },
    });
  }
  return ok({
    results,
    total: results.length,
    kb_index: flags['--kb-index'] || 'memory_main',
    tag: 'memory',
  });
}

function round2(n) { return Math.round(n * 100) / 100; }

function cmdMemoryUpload(args) {
  // CLI: memory upload <session_dir> [--kb-index K] [--vector-model V] [--wait]
  if (args.includes('--help')) return ok({});
  if (inject === 'index_conflict') return fail('INDEX_BINDING_CONFLICT', 'mock injected');

  const flags = parseFlags(args);
  // session_dir 是第一个非 flag 参数
  const sessionDir = args.find(a => !a.startsWith('--'));
  if (!sessionDir) return fail('INVALID_ARGS', 'session_dir is required');

  let sessionId = `mock-${crypto.randomUUID()}`;
  const metaFile = path.join(sessionDir, 'meta.json');
  if (fs.existsSync(metaFile)) {
    try {
      const meta = JSON.parse(fs.readFileSync(metaFile, 'utf-8'));
      if (meta && typeof meta.session_id === 'string') sessionId = meta.session_id;
    } catch { /* ignore */ }
  }

  const kbIndex = flags['--kb-index'] || 'memory_main';
  const taskId = `mock-imp-${crypto.randomUUID().slice(0, 8)}`;
  upsertTask(taskId, {
    task_id: taskId,
    task_type: 'import.memory',
    status: 'queued',
    polls: 0,
    result: { session_id: sessionId, kb_index: kbIndex, chunks_count: 5 },
  });
  return ok({
    task_id: taskId,
    status: 'queued',
    kb_index: kbIndex,
    session_id: sessionId,
  });
}

function cmdMemoryDownload(args) {
  // CLI: memory download [<memory_id>] [--storage-path P] --output DIR --download-name FILENAME
  // CLI 内部完成 task 提交+轮询+写盘，直接返回 {status:"downloaded", output_path}
  if (args.includes('--help')) return ok({});
  if (inject === 'artifact_expired') return fail('DOWNLOAD_ARTIFACT_EXPIRED', 'mock injected');

  const flags = parseFlags(args);
  const outputDir = flags['--output'];
  const downloadName = flags['--download-name'];
  const storagePath = flags['--storage-path'] || args.find(a => !a.startsWith('--')) || '';

  if (!outputDir) return fail('INVALID_ARGS', '--output is required');
  if (!downloadName) return fail('INVALID_ARGS', '--download-name is required');

  fs.mkdirSync(outputDir, { recursive: true });

  const outputPath = path.join(outputDir, downloadName);

  // 优先使用 profile fixture 文件
  const fixturePath = profile.artifact && profile.artifact.fixtureFile;
  if (fixturePath && fs.existsSync(fixturePath)) {
    fs.copyFileSync(fixturePath, outputPath);
  } else {
    // 生成假 source.json（bible-chat-v1 格式，便于 renderChatMarkdown 渲染）
    const content = JSON.stringify({
      source_format: 'bible-chat-v1',
      session_id: 'mock-download-session',
      exported_at: new Date().toISOString(),
      turns: [
        { role: 'user',      content: `[mock] Downloaded content for storage_path: ${storagePath}` },
        { role: 'assistant', content: '[mock] This is a synthetic source file from the mock CLI. Configure `artifact.fixtureFile` in ~/.bible-mock.json to use a real fixture.' },
      ],
    }, null, 2);
    fs.writeFileSync(outputPath, content);
  }

  return ok({ status: 'downloaded', output_path: outputPath });
}

// ---------- task ----------

function dispatchTask(args) {
  const [sub, ...rest] = args;
  switch (sub) {
    case 'get':                     return cmdTaskGet(rest);
    case 'cancel':                  return cmdTaskCancel(rest);
    case '--help':                  return ok({ commands: ['get', 'cancel'] });
    default:                        return failExit(3, 'CLI_NOT_IMPLEMENTED', `task ${sub}`);
  }
}

function cmdTaskGet(args) {
  if (args.includes('--help')) return ok({});
  // CLI: task get <task_id> — task_id 是 positional
  const id = args.find(a => !a.startsWith('--'));
  if (!id) return fail('INVALID_ARGS', 'task_id required');

  const t = readTask(id);
  if (!t) return fail('NOT_FOUND', `task not found: ${id}`);

  t.polls = (t.polls || 0) + 1;

  // 优先级：BIBLE_MOCK_INJECT (slow/task_failed) > profile.task.{completeAt,failAt}
  const slow = inject === 'slow';
  const injectFail = inject === 'task_failed';
  const completeAt = slow ? 10 : Number((profile.task && profile.task.completeAt) || 3);
  const failAt = injectFail ? 3 : (profile.task && profile.task.failAt != null ? Number(profile.task.failAt) : Infinity);

  if (t.polls >= failAt && t.status !== 'failed') {
    t.status = 'failed';
    t.error = { code: 'INTERNAL', message: 'mock-injected task failure' };
  } else if (t.polls >= completeAt && t.status !== 'completed' && t.status !== 'failed' && t.status !== 'cancelled') {
    t.status = 'completed';
  } else if (t.status === 'queued') {
    t.status = 'running';
  }
  writeTask(t);

  return ok({
    task_id: t.task_id,
    task_type: t.task_type,
    status: t.status,
    result: t.status === 'completed' ? t.result : undefined,
    error: t.error,
    created_at: t.created_at || new Date().toISOString(),
    updated_at: new Date().toISOString(),
  });
}

function cmdTaskCancel(args) {
  if (args.includes('--help')) return ok({});
  // CLI: task cancel <task_id> — task_id 是 positional
  const id = args.find(a => !a.startsWith('--'));
  const t = readTask(id);
  if (!t) return ok({ task_id: id, status: 'cancelled' });
  t.status = 'cancelled';
  writeTask(t);
  return ok({ task_id: id, status: 'cancelled' });
}

// ---------- state ----------

function loadState() {
  try { return JSON.parse(fs.readFileSync(STATE_PATH, 'utf-8')); } catch { return { tasks: {} }; }
}
function saveState(s) { fs.writeFileSync(STATE_PATH, JSON.stringify(s)); }
function upsertTask(id, rec) {
  const s = loadState();
  s.tasks[id] = { ...rec, created_at: (s.tasks[id] && s.tasks[id].created_at) || new Date().toISOString() };
  saveState(s);
}
function readTask(id) { return loadState().tasks[id]; }
function writeTask(t) {
  const s = loadState();
  s.tasks[t.task_id] = t;
  saveState(s);
}

// ---------- profile ----------

function loadProfile() {
  let raw = {};
  try {
    if (fs.existsSync(PROFILE_PATH)) {
      raw = JSON.parse(fs.readFileSync(PROFILE_PATH, 'utf-8')) || {};
    }
  } catch (e) {
    process.stderr.write(`[mock-cli] failed to parse profile ${PROFILE_PATH}: ${e.message}\n`);
    raw = {};
  }
  return {
    inject: raw.inject ?? DEFAULT_PROFILE.inject,
    search: { ...DEFAULT_PROFILE.search, ...(raw.search || {}) },
    task: { ...DEFAULT_PROFILE.task, ...(raw.task || {}) },
    artifact: { ...DEFAULT_PROFILE.artifact, ...(raw.artifact || {}) },
  };
}

// ---------- utils ----------

function parseFlags(args) {
  const out = {};
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith('--')) {
      const next = args[i + 1];
      if (!next || next.startsWith('--')) { out[a] = true; }
      else { out[a] = next; i++; }
    }
  }
  return out;
}

function mkHit(sessionId, score, abstract) {
  return {
    session_id: sessionId,
    storage_path: `mock/memory/${sessionId}.json`,
    abstract,
    score,
    hit_field: 'abstract',
    snippet: abstract,
    meta: { session_kind: 'mixed' },
  };
}

function ok(data) {
  process.stdout.write(JSON.stringify({ ok: true, data }) + '\n');
  process.exit(0);
}
function fail(code, message) {
  process.stdout.write(JSON.stringify({ ok: false, error: { code, message } }) + '\n');
  process.exit(1);
}
function failExit(exitCode, code, message) {
  process.stdout.write(JSON.stringify({ ok: false, error: { code, message } }) + '\n');
  process.exit(exitCode);
}
