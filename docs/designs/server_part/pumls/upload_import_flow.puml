@startuml upload_import_flow
title 上传导入流程概览（CODE / SCT / BUILD / SKILL）
note "MEMORY 独立链路见 memory_import_flow.puml\nPOST /api/v1/memory/import" as MEMORY_NOTE

|Client|
start
:POST /api/v1/upload\nmultipart/form-data: files, doc_type, index_name, ...;

|app/api/v1/upload_api.py|
:upload_documents(files, doc_type, index_name, use_vector, ...)\n→ 参数 & 文件校验\n→ UploadService.create_import_task(...)\n→ 202 Accepted + task_id;

if (校验失败?) then (是)
  :400 / 413;
  stop
endif

|features/upload/upload_service.py|
:UploadService.create_import_task(files, doc_type, index_name, ...)\n→ 落盘到 /app/uploads/{doc_type}/...\n→ Celery.apply_async(import_task, args={doc_id, file_path, doc_type, ...});

|tasks/import_task.py  [Celery Worker]|
:import_task(doc_id, file_path, doc_type, index_name, use_vector, ...)\n→ UploadRepositoryFactory.create(doc_type)  → 具体 Repository\n→ repository.parse_and_index(file_path, index_name)\n→ document_manager.bulk_import(index_name, docs)\n→ status = "completed";

|Client|
:GET /api/v1/tasks/{task_id}  → 轮询结果;

stop

@enduml
