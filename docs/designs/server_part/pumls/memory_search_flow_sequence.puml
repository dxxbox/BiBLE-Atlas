@startuml memory_search_flow_sequence
title MEMORY 检索时序 - 独立链路 (POST /api/v1/memory/search)

actor Client
participant "API\nmemory_api.py" as Api
participant "Service\nmemory_search_service.py" as Service
participant "VectorTool" as VectorTool
participant "Repository\nmemory_search_repository.py" as Repository
participant "Filters\nfilters.py" as Filters
participant "QueryBuilder\nquery_builder.py" as QueryBuilder
participant "SearchClient" as SearchClient
participant "ResultMapper\nresult_mapper.py" as Mapper

Client -> Api: POST /api/v1/memory/search\n(MemorySearchRequest)
Api -> Api: Pydantic 校验 MemorySearchRequest
alt 校验失败
  Api --> Client: 422
end

Api -> Service: search(req)

alt search_type ∈ {vector, hybrid}
  Service -> VectorTool: embed(req.query)
  VectorTool --> Service: query_vector
else keyword
  note right of Service
    query_vector = None
  end note
end

Service -> Repository: search(req, query_vector)

Repository -> Filters: normalize_memory_filters(req.filters)
Filters --> Repository: NormalizedMemoryFilters

Repository -> QueryBuilder: detect_task_id_in_query(req.query)
QueryBuilder --> Repository: auto_task_ids

Repository -> QueryBuilder: build_memory_query_spec(query, search_type, filters, top_k)
QueryBuilder --> Repository: MemoryQuerySpec

Repository -> Repository: _build_memory_dsl(spec, query_vector)
Repository -> SearchClient: search("bible_atlas_memory", dsl)
SearchClient --> Repository: memory_hits

alt spec.enable_message_level
  Repository -> Repository: _build_message_dsl(spec, candidate_ids, query_vector)
  Repository -> SearchClient: search("bible_atlas_memory_chunks", dsl)
  SearchClient --> Repository: message_hits
else
  note right of Repository
    message_hits = []
  end note
end

Repository --> Service: (memory_hits, message_hits)

Service -> Mapper: map_memory_hits(memory_hits, message_hits, include_raw_preview)
note right of Mapper
  _group_hits_by_memory
  _build_memory_search_item:
    match_scope, matched_message_preview
    overview_excerpt = overview[:300] (运行时截取)
    match_reason
  sorted by score [:top_k]
end note
Mapper --> Service: list[MemorySearchItem]

Service --> Api: MemorySearchResponse\n(success, total, memories, warnings)
Api --> Client: 200 JSON

Client -> Api: [可选] GET /api/v1/download/memory/{memory_id}
note right of Api
  server 依据 storage_path_ref
  读取并返回 message.json
end note

@enduml
