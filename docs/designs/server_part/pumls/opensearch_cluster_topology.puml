@startuml opensearch_cluster_topology
title OpenSearch 集群部署拓扑（参见 06 第一章）

skinparam shadowing false
skinparam backgroundColor #FEFEFE

cloud "Docker 网络" as docker_net {
  rectangle "os01 opensearch-os01" as os01 #DDEEFF {
    [cluster_manager only] as m1
  }
  rectangle "os02 opensearch-os02" as os02 #DDFFDD {
    [data + ingest] as d2
  }
  rectangle "os03 opensearch-os03" as os03 #DDFFDD {
    [data + ingest] as d3
  }
}

os01 -[#Blue]-> os02 : transport 9300
os01 -[#Blue]-> os03 : transport 9300
os02 -[#Blue]-> os03 : transport 9300

note bottom of os01
  image localhost bible-opensearch ik-knn
  cluster name bible-opensearch
  host HTTP e.g. 19200 to 9200
  JVM -Xms2g -Xmx2g
end note

actor "应用或运维" as user
user --> os01 : HTTP 宿主机 19200

note right of user
  健康检查
  _cluster/health
  _cat/nodes
end note

@enduml
