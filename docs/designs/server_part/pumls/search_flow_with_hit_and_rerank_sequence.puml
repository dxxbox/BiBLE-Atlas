@startuml search_flow_with_hit_and_rerank_sequence
title 检索时序 - enable_hit、Rerank、AI 增强检索

actor Client
participant "API\nsearch_api.py" as Api
participant "Service\nsearch_service.py" as Service
participant "TagQuery" as TagQuery
participant "IndexSearchTasks" as IndexTasks
participant "Factory\nSearchRepositoryFactory" as Factory
participant "Repository\nBaseSearchRepository" as Repository
participant "SearchClient" as SearchClient
participant "RerankTool" as RerankTool
participant "CopilotCLI\nAiRankingRunner" as CopilotCLI

Client -> Api: POST /api/v1/search
Api -> Api: 校验 SearchRequest
Api -> Service: search(req: SearchRequest)

Service -> TagQuery: resolve tag and query_for_search
TagQuery --> Service: effective_tag, query_for_search

Service -> IndexTasks: build tasks
IndexTasks --> Service: list[IndexSearchTask]

loop each IndexSearchTask
  Service -> Factory: create(task.index_tag, ...)
  Factory --> Service: repository

  Service -> Repository: search(task, req, fetch_size)
  Repository -> SearchClient: search(...)
  SearchClient --> Repository: raw response

  Repository -> Repository: map_backend_response_to_items()\n-> list[SearchMatchRow]

  alt rerank enabled
    Repository -> RerankTool: rerank(rows)
    RerankTool --> Repository: reranked rows
  end

  alt ai_enable
    Repository -> CopilotCLI: ai filter(rows)
    CopilotCLI --> Repository: filtered rows / error
    note right of Repository
      on ai error or timeout:
      fallback to previous step
      and take top_k
    end note
  end

  Repository -> Repository: format_bucket_items()
  Repository --> Service: repository result bucket
end

Service -> Service: _merge_results(task_results)
Service -> Service: total = sum(len(bucket) for bucket in results.values())
Service --> Api: SearchResponse
Api --> Client: JSON response

@enduml
