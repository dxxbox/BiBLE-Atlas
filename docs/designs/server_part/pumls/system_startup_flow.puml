@startuml system_startup_flow
title 系统启动流程（分层架构 + 后台模型加载）

|main.py|
start
:系统启动开始;

|配置层\nconfig/|

partition "1. 加载静态配置" {
  :读取环境变量和 .env 文件;
  :创建 Settings 实例;
  note right
    config/settings.py
    包含：
    - 数据库连接信息（ES/PG/OpenSearch）
    - Redis 连接信息（可选）
    - Celery 连接信息
    - 应用基础配置
    - 安全配置
    - 文件路径配置
  end note
  
  if (必要配置缺失?) then (是)
    :输出错误日志;
    :启动失败;
    stop
  endif
}

partition "2. 初始化日志系统" {
  :配置日志格式和级别;
  :创建日志处理器\n(文件/控制台);
  note right
    config/logging.py
    - 设置日志级别
    - 配置日志格式
    - 设置日志输出目标
    - 配置日志轮转
  end note
  
  :记录启动日志;
}

partition "3. 加载动态配置" {
  :读取 dynamic_config.yaml;
  :创建 ConfigManager 实例;
  note right
    config/config_manager.py
    加载所有热更新配置：
    - 向量模型配置
    - 知识库索引配置
    - 检索类型配置
    - 搜索参数配置
    - rerank 配置
    - 上传配置
    等等...
  end note
  
  :验证配置完整性;
  
  if (配置文件有误?) then (是)
    :记录警告日志\n使用默认配置;
  endif
}

|数据库层\ninfrastructure/|

partition "4. 初始化数据库（按配置选择）" {
  switch (数据库类型?)
  case (Elasticsearch)
    :从配置读取 ES 连接信息;
    :创建 ES 客户端;
    note right
      infrastructure/elasticsearch/client.py
    end note
    :测试连接;
    
    if (ES 连接成功?) then (是)
      :记录 ES 集群信息\n(版本、节点数等);
    else (否)
      :记录错误日志;
      :启动失败;
      stop
    endif
    
  case (PostgreSQL+pgvector)
    :从配置读取 PG 连接信息;
    :创建 asyncpg 客户端;
    note right
      infrastructure/postgres/client.py
    end note
    :测试连接;
    
    if (PG 连接成功?) then (是)
      :记录 PG 版本和 pgvector 扩展状态;
    else (否)
      :记录错误日志;
      :启动失败;
      stop
    endif
    
  case (OpenSearch)
    :从配置读取 OpenSearch 连接信息;
    :创建 OpenSearch 客户端;
    note right
      infrastructure/opensearch/client.py
    end note
    :测试连接;
    
    if (OpenSearch 连接成功?) then (是)
      :记录 OpenSearch 集群信息;
    else (否)
      :记录错误日志;
      :启动失败;
      stop
    endif
  endswitch
}

partition "5. 初始化 Redis（可选）" {
  if (配置中启用 Redis?) then (是)
    :从配置读取 Redis 连接信息;
    :创建 Redis 客户端;
    note right
      infrastructure/redis/client.py
      用于：
      - Celery broker（优先）
      - 缓存（可选）
      - 分布式锁（可选）
    end note
    :测试连接 (PING);
    
    if (Redis 连接成功?) then (是)
      :记录连接成功;
      :设置 redis_available = True;
    else (否)
      :记录警告：Redis 连接失败;
      :设置 redis_available = False;
      note right
        系统继续启动，
        Celery 将使用 Memory broker
      end note
    endif
  else (否)
    :跳过 Redis 初始化;
    :记录：Redis 未启用;
    :设置 redis_available = False;
  endif
}

|任务队列层\ninfrastructure/celery/|

partition "6. 初始化 Celery（自动降级）" {
  if (redis_available?) then (是)
    :使用 Redis broker;
    note right
      broker_url = 'redis://host:6379/0'
      result_backend = 'redis://host:6379/1'
      
      ✓ 支持分布式 Worker
      ✓ 任务持久化，重启不丢失
      ✓ 适合生产环境
    end note
  else (否)
    :使用 Memory broker（降级）;
    note right
      broker_url = 'memory://'
      result_backend = 'cache+memory://'
      
      ⚠ 单机模式
      ⚠ 重启丢失未完成任务
      ✓ 无需外部依赖
      ✓ 适合开发/单机部署
    end note
  endif
  
  :创建 Celery 应用实例;
  :配置任务路由;
  :注册所有异步任务;
  note right
    infrastructure/celery/app.py
    注册任务：
    - load_vector_models_task
    - load_rerank_models_task
    - process_large_document
    - import_document_task
    - reindex_task
    等等...
  end note
  
  :记录 Celery 配置信息;
}

|向量模型层\ninfrastructure/vector/|

partition "7. 启动向量模型加载（异步/同步）" {
  :从配置读取 vector_models;
  
  if (load_on_startup = true?) then (是)
    note right
      **当前设计：Celery 总是可用**
      - Redis 可用 → Redis broker
      - Redis 不可用 → Memory broker
      
      因此模型加载总是异步执行
    end note
    
    fork
      :主线程：跳过等待\n继续启动流程;
    fork again
      |Celery Worker|
      :后台任务：异步加载向量模型;
      note right
        infrastructure/vector/vector_tool.py
        模型存储位置：
        ~/.cache/huggingface/
        或
        /app/models/vector_models/
      end note
      
      while (还有模型未加载?) is (是)
        :下载/加载模型到内存;
        note right
          使用 sentence-transformers
          - all-MiniLM-L6-v2 (384d)
          - BAAI/bge-large-zh-v1.5 (1024d)
          - 等等...
        end note
        :预热模型推理;
        :记录加载进度;
      endwhile (否)
      
      :记录所有模型加载完成;
      detach
    end fork
  else (否)
    :记录使用懒加载模式;
    note right
      模型在首次使用时才加载
    end note
  endif
}

partition "8. 启动 Rerank 模型加载（异步/同步）" {
  :从配置读取 rerank 配置;
  
  if (rerank.enable = true\n且 preload_on_startup = true?) then (是)
    fork
      :主线程：跳过等待\n继续启动流程;
    fork again
      |Celery Worker|
      :后台任务：异步加载 rerank 模型;
      note right
        infrastructure/vector/rerank_tool.py
        模型存储位置：
        ~/.cache/huggingface/
        或
        /app/models/rerank_models/
      end note
      
      while (还有 rerank 模型未加载?) is (是)
        :下载/加载 rerank 模型;
        note right
          使用 cross-encoder
          - BAAI/bge-reranker-base
          - BAAI/bge-reranker-large
          - 等等...
        end note
        :记录加载进度;
      endwhile (否)
      
      :记录 rerank 模型加载完成;
      detach
    end fork
  else (否)
    :跳过 rerank 模型预加载;
  endif
}

|应用层\napp/|

partition "9. 初始化 FastAPI 应用" {
  :创建 FastAPI 实例;
  :配置 CORS 中间件;
  :注册异常处理器;
  :注册所有路由;
  note right
    app/api/v1/__init__.py
    注册路由：
    - search_api.py
    - upload_api.py
    - download_api.py
    - docs_api.py
    - info_api.py
    - admin_api.py
  end note
  
  :配置 OpenAPI 文档;
}

partition "10. 健康检查" {
  :执行系统自检;
  :检查数据库连接状态;
  if (Redis 配置?) then (是)
    :检查 Redis 连接状态;
  endif
  :检查向量模型状态\n(已加载/懒加载);
  
  if (所有必要组件正常?) then (是)
    :系统状态 = healthy;
  else (否)
    :系统状态 = degraded;
    :记录降级原因;
  endif
}

:记录启动完成日志;
note right
  显示：
  - 应用版本
  - 监听地址和端口
  - 数据库类型和状态
  - Redis 状态（如启用）
  - 向量模型加载状态
  - 启动耗时
end note

:启动 Uvicorn 服务器;
:开始监听 HTTP 请求;

note right
  uvicorn main:app
  --host 0.0.0.0
  --port 8000
  --workers 4
  
  ⚠️ 注意：
  如果启用了后台模型加载，
  系统在模型完全加载前就已就绪，
  首次使用模型的请求可能需要等待。
end note

:系统就绪\n可以处理 API 请求;

stop

@enduml
